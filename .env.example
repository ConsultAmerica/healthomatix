HEALTHOMATIX_ENV=development
# Defaults to true in development when unset. Keep false outside approved demos.
SCHEDULING_ENABLED=true
# Local private document store for synthetic demos. Leave empty in production.
DOCUMENT_STORAGE_PATH=./.document-storage
DATABASE_URL=postgresql+psycopg://healthomatix:change-me@localhost:5432/healthomatix
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8000
# Semicolon-separated trusted OIDC issuer|subject pairs; never self-assigned by tenant role.
PLATFORM_ADMIN_IDENTITIES=

# --- Web portal (apps/web/.env.local) ---
# Server-side API address used by the same-origin /api/v1 proxy.
HEALTHOMATIX_API_URL=http://localhost:8000
# Public URL of the web app; {APP_BASE_URL}/auth/callback must be registered with the identity provider.
APP_BASE_URL=http://localhost:3000
# OIDC_ISSUER and OIDC_AUDIENCE above are shared with the web app.
OIDC_CLIENT_ID=
# Leave empty for public (PKCE-only) clients.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile offline_access
# Require MFA at the identity provider (IdP policy). The app does not ship in-app TOTP.
# Document intelligence uses Fake OCR/LLM adapters unless a BAA-covered provider is wired.
# At least 32 random characters; encrypts the httpOnly session cookie. Rotate to sign everyone out.
SESSION_SECRET=
# Published consent policy version; consent granting is disabled until this is set.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=

# --- Demo mode (synthetic testing only; refused when HEALTHOMATIX_ENV=production) ---
# Same 32+ character value on BOTH the API and the web app. Leave empty to disable.
DEMO_AUTH_SECRET=
# Web only: optional passcode testers must enter before choosing a demo account.
DEMO_PASSCODE=

# --- V1.8 security / launch controls ---
# development | staging | pilot | production
LAUNCH_MODE=development
# Default true in production. Platform admin OIDC tokens must include MFA evidence (amr/acr).
REQUIRE_MFA_FOR_PLATFORM_ADMIN=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
# Default true in production. Uploads fail closed until an approved malware scanner is wired.
DOCUMENT_REQUIRE_MALWARE_CLEAR=false
